<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <!-- Login is a single shared password compared against ADMIN_PASSWORD.
         Pinning it here keeps the suite hermetic: routes/web.php locks every
         route behind a fallback when it is empty, so a developer's .env
         would otherwise decide whether the app under test has any routes. -->
    <env name="ADMIN_PASSWORD" value="testing-password"/>
    <env name="CACHE_DRIVER" value="array"/>
    <!-- An in-memory database, private to the process. The throwaway file
         this used to be left two test runs free to corrupt each other's
         migrations, and a corrupted one fails every test until deleted. -->
    <env name="DB_CONNECTION" value="sqlite"/>
    <env name="DB_DATABASE" value=":memory:"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="TELESCOPE_ENABLED" value="false"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
