#!/usr/bin/python3
"""
Ask Let's Encrypt for every certificate Deployable has requested.

deployable-ssl.service runs this as root; deployable-ssl.path triggers it
whenever a *.req file lands in /etc/deployable/ssl-requests, which is where the
web app puts them. Each request comes back as a *.req-turned-*.json result in
/etc/deployable/ssl-results, carrying the same nonce the request had so the web
app can't mistake yesterday's outcome for today's.

Only a domain that already has a live vhost in the drop-in directory is
eligible: without that, anybody who can write a request file could ask this
server to fetch certificates for any domain pointed at it.

The request lists every name the site answers for. Each extra name has to
appear on that vhost (ServerName or ServerAlias) and resolve in DNS; names
that can't pass a Let's Encrypt challenge are left out of the certificate and
reported, so one dead alias can't take the working names down with it.
"""

import glob
import json
import os
import re
import socket
import subprocess
import tempfile
from datetime import datetime, timezone

REQ_DIR = "/var/www/deployable.timkoop.com/storage/app/apache/ssl-requests"
RESULT_DIR = "/var/www/deployable.timkoop.com/storage/app/apache/ssl-results"
VHOST_DIR = "/var/www/deployable.timkoop.com/storage/app/apache/vhosts"
CERTBOT = "/snap/bin/certbot"

DOMAIN_RE = re.compile(
    r"^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
)
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")

TIMEOUT_SECONDS = 180


def atomic_write(path, contents, mode=0o644):
    directory = os.path.dirname(path) or "."
    fd, temp = tempfile.mkstemp(dir=directory, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(contents)
        os.chmod(temp, mode)
        os.replace(temp, path)
    except Exception:
        if os.path.exists(temp):
            os.unlink(temp)
        raise


def check(request):
    """Everything that has to be true before certbot is worth running."""
    domain = str(request.get("domain") or "")
    email = str(request.get("email") or "")
    webroot = str(request.get("webroot") or "")

    problems = []

    if not DOMAIN_RE.match(domain):
        problems.append(f"'{domain}' isn't a domain name.")
    elif not os.path.isfile(os.path.join(VHOST_DIR, domain + ".conf")):
        problems.append(
            f"{domain} has no enabled vhost in {VHOST_DIR}, so there'd be "
            "nothing for the Let's Encrypt check to reach. Enable the site "
            "first."
        )

    if not EMAIL_RE.match(email):
        problems.append(f"'{email}' isn't an email address Let's Encrypt can reach.")

    if not webroot.startswith("/") or not os.path.isdir(webroot):
        problems.append(f"The web root '{webroot}' isn't an absolute path to a directory.")

    if not os.path.isfile(CERTBOT):
        problems.append(f"certbot isn't installed - there's no {CERTBOT}.")

    return problems


def request_cert(domain, email, webroot, hosts):
    command = [CERTBOT, "certonly", "--webroot", "-w", webroot]

    for host in hosts:
        command += ["-d", host]

    command += [
        "--email", email,
        "--cert-name", domain,
        "--non-interactive",
        "--agree-tos",
        "--keep-until-expiring",
    ]

    proc = subprocess.run(command, capture_output=True, text=True, timeout=TIMEOUT_SECONDS)

    return proc.returncode == 0, (proc.stdout + proc.stderr).strip()


def hosts_from(request, domain):
    """The names to certify: the primary domain first, then its vhost aliases."""
    supplied = request.get("hosts")

    if not isinstance(supplied, list):
        supplied = [domain]

    hosts = []

    for host in supplied:
        host = str(host).strip().lower()

        if host and host not in hosts:
            hosts.append(host)

    if domain not in hosts:
        hosts.insert(0, domain)

    return hosts


def names_on_vhost(path):
    """ServerName and ServerAlias names from the vhost, lowercased."""
    names = set()

    try:
        with open(path) as handle:
            contents = handle.read()
    except OSError:
        return names

    for line in contents.splitlines():
        match = re.match(r"\s*Server(?:Name|Alias)\s+(\S.*)$", line, re.IGNORECASE)

        if match:
            names.update(token.lower() for token in match.group(1).split())

    return names


def resolves(host):
    """True when the name currently has DNS, which a Let's Encrypt check needs."""
    try:
        socket.getaddrinfo(host, None, socket.AF_INET, socket.SOCK_STREAM)
        return True
    except socket.gaierror:
        try:
            socket.getaddrinfo(host, None, socket.AF_INET6, socket.SOCK_STREAM)
            return True
        except socket.gaierror:
            return False


def certifiable_hosts(request, domain):
    """The names to put in the certificate, and why any others were left out.

    A name that doesn't resolve, or isn't on the site's vhost, can't pass a
    Let's Encrypt challenge - and one bad name fails the whole order, taking
    every other name with it. Those get left out and reported instead.
    """
    vhost = os.path.join(VHOST_DIR, domain + ".conf")
    allowed = names_on_vhost(vhost)
    wanted = hosts_from(request, domain)

    hosts, skipped = [], []

    for host in wanted:
        if host != domain:
            if not DOMAIN_RE.match(host):
                skipped.append(f"{host} isn't a domain name.")
                continue

            if host not in allowed:
                skipped.append(f"{host} isn't an alias of {domain} in its vhost.")
                continue

        if not resolves(host):
            skipped.append(
                f"{host} has no DNS record yet, so Let's Encrypt can't reach it."
                " Fix the DNS and request again."
            )
            continue

        hosts.append(host)

    return hosts, skipped


def process(path):
    try:
        with open(path) as handle:
            request = json.load(handle)
    except (OSError, ValueError) as error:
        # A malformed request is still answered, so the web app waiting on a
        # nonce hears back instead of spinning until its timeout.
        name = os.path.basename(path)[: -len(".req")]
        name = name if DOMAIN_RE.match(name) else "unknown"
        write_result(name, False, f"Could not read the request: {error}", "", None)
        os.unlink(path)
        return

    domain = str(request.get("domain") or "")
    nonce = str(request.get("nonce") or "")

    problems = check(request)
    if problems:
        write_result(domain, False, "\n".join(problems), nonce, None)
        os.unlink(path)
        return

    hosts, skipped = certifiable_hosts(request, domain)

    if not hosts:
        write_result(domain, False, "\n".join(
            [f"No name for {domain} could pass a Let's Encrypt challenge."]
            + skipped
        ), nonce, None)
        os.unlink(path)
        return

    try:
        ok, output = request_cert(
            domain,
            str(request.get("email") or ""),
            str(request.get("webroot") or ""),
            hosts,
        )
    except subprocess.TimeoutExpired:
        ok, output = False, f"certbot did not finish within {TIMEOUT_SECONDS} seconds."
    except OSError as error:
        ok, output = False, f"Could not run certbot: {error}"

    if ok and skipped:
        output = (output + "\n\nCertificate covers: " + ", ".join(hosts) +
                  ". Left out (" + "; ".join(skipped) + ")").strip()

    write_result(domain, ok, output, nonce, {
        "cert": f"/etc/letsencrypt/live/{domain}/fullchain.pem",
        "key": f"/etc/letsencrypt/live/{domain}/privkey.pem",
    } if ok else None)

    os.unlink(path)


def write_result(domain, ok, output, nonce, paths):
    payload = {
        "ok": bool(ok),
        "nonce": nonce,
        "at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "message": output.splitlines()[-1] if output else "",
        "output": output,
        "paths": paths,
    }

    # The result directory belongs to root: the app reads it, and can neither
    # create nor replace what's in it.
    target = os.path.join(RESULT_DIR, f"{domain}.json")
    atomic_write(target, json.dumps(payload, indent=2) + "\n", 0o644)


def main():
    os.makedirs(REQ_DIR, exist_ok=True)
    os.makedirs(RESULT_DIR, exist_ok=True)

    for path in sorted(glob.glob(os.path.join(REQ_DIR, "*.req"))):
        process(path)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
