[Unit]
Description=Watch Deployable's Apache drop-in directory
Documentation=https://deployable.timkoop.com

[Path]
# Any file here appearing, vanishing or being renamed re-runs the validator.
PathChanged=/var/www/deployable.timkoop.com/storage/app/apache/vhosts
Unit=deployable-vhost.service

[Install]
WantedBy=multi-user.target
